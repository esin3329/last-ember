{
  "name": "last-ember",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "결정론적 시뮬레이션 + 서버 리플레이 검증 로그라이트 액션",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server/src/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/src/main.ts",
    "backup": "node scripts/backup.ts",
    "test": "node --test \"shared/test/*.test.ts\" \"client/test/*.test.ts\" \"server/test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "balance": "node scripts/balance.ts",
    "verify:csharp": "node scripts/fixtures.ts && dotnet run --project csharp/LastEmber.Verify -c Release -- csharp/fixtures.json"
  },
  "engines": { "node": ">=24" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
